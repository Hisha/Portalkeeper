<Window
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Portalkeeper.ViewModels"
    x:Class="Portalkeeper.Views.SettingsWindow"
    x:DataType="vm:MainViewModel"
    Width="760"
    Height="560"
    MinWidth="680"
    MinHeight="500"
    Title="Portalkeeper Settings"
    WindowStartupLocation="CenterOwner"
    Background="#091019">

    <Window.Styles>
        <Style Selector="Button">
            <Setter Property="Background" Value="#111A24" />
            <Setter Property="Foreground" Value="#F6D477" />
            <Setter Property="BorderBrush" Value="#9A6B1E" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Button:pointerover">
            <Setter Property="Background" Value="#1B2A38" />
            <Setter Property="BorderBrush" Value="#D2A43A" />
            <Setter Property="Foreground" Value="#FFE9A8" />
        </Style>
        <Style Selector="Button:pressed">
            <Setter Property="Background" Value="#0C131B" />
        </Style>
        <Style Selector="CheckBox">
            <Setter Property="Foreground" Value="#EDE4D2" />
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,*,Auto">
        <!-- Shared Portalkeeper cinematic header -->
        <Border Grid.Row="0"
                Background="#0A1119"
                BorderBrush="#A06E1B"
                BorderThickness="0,0,0,2">
            <Grid Height="104" ClipToBounds="True">
                <Image Source="/Assets/Calendar/calendar-banner.png"
                       Stretch="UniformToFill"
                       Opacity="0.86" />
                <Border Background="#77040A12" />

                <Grid Margin="20,10" ColumnDefinitions="68,*,Auto">
                    <Border Width="58"
                            Height="58"
                            CornerRadius="29"
                            BorderBrush="#B77A20"
                            BorderThickness="2"
                            Background="#11131A"
                            VerticalAlignment="Center">
                        <Image Source="/Assets/portalkeeper-icon.png"
                               Margin="3"
                               Stretch="Uniform" />
                    </Border>

                    <StackPanel Grid.Column="1"
                                Margin="14,0,0,0"
                                VerticalAlignment="Center"
                                Spacing="2">
                        <TextBlock Text="SETTINGS"
                                   Foreground="#FFD96B"
                                   FontSize="25"
                                   FontWeight="Bold" />
                        <TextBlock Text="Client, realm, and launch preferences"
                                   Foreground="#E8DDC8"
                                   FontSize="13" />
                    </StackPanel>

                    <StackPanel Grid.Column="2"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Right"
                                Spacing="2">
                        <TextBlock Text="PORTALKEEPER"
                                   HorizontalAlignment="Right"
                                   Foreground="#DCCAF2"
                                   FontSize="12"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="PLAN. PREPARE. PLAY."
                                   HorizontalAlignment="Right"
                                   Foreground="#8F7AA8"
                                   FontSize="9" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1">
            <StackPanel Margin="20,18" Spacing="14">
                <!-- Client -->
                <Border Background="#0E1823"
                        BorderBrush="#6E5426"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="16">
                    <Grid ColumnDefinitions="Auto,*">
                        <Border Width="42" Height="42"
                                CornerRadius="21"
                                Background="#172330"
                                BorderBrush="#8A6726"
                                BorderThickness="1"
                                VerticalAlignment="Center">
                            <TextBlock Text="C"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="#F6D477"
                                       FontSize="17"
                                       FontWeight="Bold" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="14,0,0,0" Spacing="4">
                            <TextBlock Text="CLIENT"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="#D5AA50" />
                            <TextBlock Text="{Binding ClientPath}"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="#F8F0DF"
                                       TextWrapping="Wrap" />
                            <TextBlock Text="{Binding ClientStatus}"
                                       FontSize="12"
                                       Foreground="#AFA28D"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Realm -->
                <Border Background="#0E1823"
                        BorderBrush="#6E5426"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="16">
                    <Grid ColumnDefinitions="Auto,*">
                        <Border Width="42" Height="42"
                                CornerRadius="21"
                                Background="#172330"
                                BorderBrush="#8A6726"
                                BorderThickness="1"
                                VerticalAlignment="Center">
                            <TextBlock Text="R"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="#F6D477"
                                       FontSize="17"
                                       FontWeight="Bold" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="14,0,0,0" Spacing="4">
                            <TextBlock Text="REALM"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="#D5AA50" />
                            <TextBlock Text="{Binding RealmName}"
                                       FontSize="17"
                                       FontWeight="SemiBold"
                                       Foreground="#F8F0DF" />
                            <TextBlock Text="{Binding RealmStatus}"
                                       FontSize="12"
                                       Foreground="#AFA28D"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Launch environment -->
                <Border Background="#0E1823"
                        BorderBrush="#6E5426"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="16">
                    <Grid ColumnDefinitions="Auto,*">
                        <Border Width="42" Height="42"
                                CornerRadius="21"
                                Background="#172330"
                                BorderBrush="#8A6726"
                                BorderThickness="1"
                                VerticalAlignment="Center">
                            <TextBlock Text="L"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="#F6D477"
                                       FontSize="17"
                                       FontWeight="Bold" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="14,0,0,0" Spacing="4">
                            <TextBlock Text="LAUNCH ENVIRONMENT"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="#D5AA50" />
                            <TextBlock Text="{Binding LaunchEnvironmentStatus}"
                                       FontSize="13"
                                       Foreground="#D8CCBA"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Behavior -->
                <Border Background="#0A141E"
                        BorderBrush="#40331E"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="16">
                    <StackPanel Spacing="10">
                        <TextBlock Text="BEHAVIOR"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Foreground="#D5AA50" />
                        <CheckBox IsChecked="{Binding HidePortalkeeperWhileGameRuns, Mode=TwoWay}"
                                  Content="Hide Portalkeeper while World of Warcraft is running" />
                        <TextBlock Text="Portalkeeper will return when the game closes."
                                   Margin="26,0,0,0"
                                   Foreground="#7F776B"
                                   FontSize="11" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2"
                Background="#081019"
                BorderBrush="#5B431B"
                BorderThickness="0,1,0,0"
                Padding="18,12">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="Portalkeeper preferences"
                           VerticalAlignment="Center"
                           Foreground="#756B5C"
                           FontSize="11" />
                <Button Grid.Column="1"
                        Content="CLOSE"
                        Click="Close_Click"
                        Padding="20,9" />
            </Grid>
        </Border>
    </Grid>
</Window>

<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:Portalkeeper.ViewModels"
        mc:Ignorable="d"
        x:Class="Portalkeeper.Views.CalendarWindow"
        x:DataType="vm:CalendarViewModel"
        Title="Realm Calendar"
        Width="1060"
        Height="820"
        MinWidth="880"
        MinHeight="700"
        WindowStartupLocation="CenterOwner"
        Background="#15131B">

  <Window.Styles>
    <Style Selector="Button.nav">
      <Setter Property="Background" Value="#332B42"/>
      <Setter Property="Foreground" Value="#F3EFF8"/>
      <Setter Property="BorderBrush" Value="#554669"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="5"/>
    </Style>
    <Style Selector="Button.nav:pointerover">
      <Setter Property="Background" Value="#493A5E"/>
      <Setter Property="BorderBrush" Value="#75608E"/>
    </Style>
    <Style Selector="Button.nav:disabled">
      <Setter Property="Background" Value="#18151E"/>
      <Setter Property="Foreground" Value="#625B6C"/>
      <Setter Property="BorderBrush" Value="#292431"/>
    </Style>

    <Style Selector="Button.day">
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Margin" Value="2"/>
      <Setter Property="CornerRadius" Value="3"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="VerticalContentAlignment" Value="Stretch"/>
      <Setter Property="BorderThickness" Value="1"/>
    </Style>
    <Style Selector="Button.day:pointerover">
      <Setter Property="BorderThickness" Value="2"/>
    </Style>
  </Window.Styles>

  <Grid RowDefinitions="Auto,Auto,*,Auto,Auto">
    <!-- Portalkeeper chrome -->
    <Border Grid.Row="0"
            Background="#201C2A"
            BorderBrush="#3A324A"
            BorderThickness="0,0,0,1"
            Padding="22,15">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel>
          <TextBlock Text="REALM CALENDAR"
                     FontSize="22"
                     FontWeight="Bold"
                     Foreground="#F3EFF8"/>
          <TextBlock Text="Public realm events"
                     Foreground="#AFA6BD"/>
        </StackPanel>
        <TextBlock Grid.Column="1"
                   Text="PORTALKEEPER"
                   VerticalAlignment="Center"
                   Foreground="#756B83"
                   FontWeight="SemiBold"
                   LetterSpacing="1.3"/>
      </Grid>
    </Border>

    <!-- Month navigation -->
    <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto" Margin="22,16,22,10">
      <Button Classes="nav"
              Content="‹ PREVIOUS"
              Click="Previous_Click"
              IsEnabled="{Binding CanPrevious}"
              Padding="16,8"/>
      <StackPanel Grid.Column="1" HorizontalAlignment="Center">
        <TextBlock Text="{Binding MonthTitle}"
                   HorizontalAlignment="Center"
                   FontSize="21"
                   FontWeight="Bold"
                   Foreground="#F3EFF8"/>
        <TextBlock Text="Select a day to view event details"
                   HorizontalAlignment="Center"
                   FontSize="11"
                   Foreground="#80768D"/>
      </StackPanel>
      <Button Grid.Column="2"
              Classes="nav"
              Content="NEXT ›"
              Click="Next_Click"
              IsEnabled="{Binding CanNext}"
              Padding="16,8"/>
    </Grid>

    <!-- Calendar parchment -->
    <Border Grid.Row="2"
            Margin="22,0"
            Background="#B8A985"
            BorderBrush="#594B37"
            BorderThickness="1"
            CornerRadius="8"
            Padding="8">
      <Grid RowDefinitions="Auto,*">
        <Grid Grid.Row="0" ColumnDefinitions="*,*,*,*,*,*,*" Margin="2,0,2,4">
          <Border Grid.Column="0" Background="#493C31" Margin="1" Padding="5"><TextBlock Text="SUN" HorizontalAlignment="Center" Foreground="#F1E4C4" FontWeight="Bold"/></Border>
          <Border Grid.Column="1" Background="#493C31" Margin="1" Padding="5"><TextBlock Text="MON" HorizontalAlignment="Center" Foreground="#F1E4C4" FontWeight="Bold"/></Border>
          <Border Grid.Column="2" Background="#493C31" Margin="1" Padding="5"><TextBlock Text="TUE" HorizontalAlignment="Center" Foreground="#F1E4C4" FontWeight="Bold"/></Border>
          <Border Grid.Column="3" Background="#493C31" Margin="1" Padding="5"><TextBlock Text="WED" HorizontalAlignment="Center" Foreground="#F1E4C4" FontWeight="Bold"/></Border>
          <Border Grid.Column="4" Background="#493C31" Margin="1" Padding="5"><TextBlock Text="THU" HorizontalAlignment="Center" Foreground="#F1E4C4" FontWeight="Bold"/></Border>
          <Border Grid.Column="5" Background="#493C31" Margin="1" Padding="5"><TextBlock Text="FRI" HorizontalAlignment="Center" Foreground="#F1E4C4" FontWeight="Bold"/></Border>
          <Border Grid.Column="6" Background="#493C31" Margin="1" Padding="5"><TextBlock Text="SAT" HorizontalAlignment="Center" Foreground="#F1E4C4" FontWeight="Bold"/></Border>
        </Grid>

        <ItemsControl Grid.Row="1" ItemsSource="{Binding Days}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <UniformGrid Columns="7" Rows="6"/>
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:CalendarDayCell">
              <Button Classes="day"
                      Click="Day_Click"
                      Background="{Binding Background}"
                      BorderBrush="{Binding BorderBrush}"
                      Opacity="{Binding CellOpacity}">
                <Grid RowDefinitions="Auto,*" MinHeight="70">
                  <Grid Grid.Row="0" ColumnDefinitions="Auto,*" Margin="7,5,6,2">
                    <Border Background="#2B2118"
                            CornerRadius="10"
                            Padding="6,2">
                      <TextBlock Text="{Binding DayNumber}"
                                 Foreground="#F7EACB"
                                 FontWeight="Bold"
                                 FontSize="12"/>
                    </Border>
                    <TextBlock Grid.Column="1"
                               Text="{Binding TodayBadge}"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               Foreground="#654D84"
                               FontSize="9"
                               FontWeight="Bold"/>
                  </Grid>

                  <StackPanel Grid.Row="1" Margin="5,2,5,5" Spacing="2">
                    <ItemsControl ItemsSource="{Binding Markers}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:CalendarEventMarker">
                          <Border Background="{Binding Background}"
                                  CornerRadius="3"
                                  Padding="5,2"
                                  Margin="0,1">
                            <TextBlock Text="{Binding Name}"
                                       Foreground="{Binding Foreground}"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis"
                                       MaxLines="1"/>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{Binding OverflowCount, StringFormat='+{0} more'}"
                               IsVisible="{Binding HasOverflow}"
                               Foreground="#6A5944"
                               FontSize="9"
                               FontWeight="SemiBold"
                               Margin="3,0,0,0"/>
                  </StackPanel>
                </Grid>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Grid>
    </Border>

    <!-- Selected day -->
    <Border Grid.Row="3"
            Margin="22,12,22,0"
            Background="#201C2A"
            BorderBrush="#3A324A"
            BorderThickness="1"
            CornerRadius="8"
            Padding="14,12">
      <Grid ColumnDefinitions="230,*">
        <StackPanel Margin="2,0,18,0">
          <TextBlock Text="SELECTED DAY"
                     Foreground="#8E839C"
                     FontSize="11"
                     FontWeight="Bold"/>
          <TextBlock Text="{Binding SelectedDayTitle}"
                     Foreground="#F3EFF8"
                     FontSize="16"
                     FontWeight="SemiBold"
                     TextWrapping="Wrap"
                     Margin="0,3,0,0"/>
        </StackPanel>

        <Grid Grid.Column="1">
          <TextBlock Text="{Binding SelectedDayEmptyText}"
                     IsVisible="{Binding !HasSelectedEvents}"
                     Foreground="#746B80"
                     VerticalAlignment="Center"/>
          <ItemsControl ItemsSource="{Binding SelectedEvents}"
                        IsVisible="{Binding HasSelectedEvents}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:CalendarEventDetailRow">
                <Grid ColumnDefinitions="8,*,Auto" Margin="0,3">
                  <Border Background="{Binding AccentBackground}" CornerRadius="3" Margin="0,1,8,1"/>
                  <StackPanel Grid.Column="1">
                    <TextBlock Text="{Binding Name}"
                               Foreground="#F3EFF8"
                               FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding CategoryText}"
                               Foreground="#80768D"
                               FontSize="10"/>
                  </StackPanel>
                  <TextBlock Grid.Column="2"
                             Text="{Binding TimeText}"
                             Foreground="#C8BED3"
                             VerticalAlignment="Center"
                             Margin="18,0,0,0"/>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Grid>
      </Grid>
    </Border>

    <!-- Feed status -->
    <Grid Grid.Row="4" ColumnDefinitions="*,Auto" Margin="22,9,22,15">
      <TextBlock Text="{Binding LoadStatus}"
                 Foreground="#AFA6BD"
                 FontSize="11"
                 TextWrapping="Wrap"/>
      <TextBlock Grid.Column="1"
                 Text="{Binding FeedRange}"
                 Foreground="#746B80"
                 FontSize="10"
                 TextWrapping="Wrap"
                 HorizontalAlignment="Right"/>
    </Grid>
  </Grid>
</Window>

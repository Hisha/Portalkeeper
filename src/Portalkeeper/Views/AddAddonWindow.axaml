<Window
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="Portalkeeper.Views.AddAddonWindow"
    Width="620"
    Height="480"
    MinWidth="560"
    MinHeight="430"
    Title="Add Personal Addon"
    WindowStartupLocation="CenterOwner"
    Background="#15121B">

    <Window.Styles>
        <Style Selector="Button">
            <Setter Property="Background" Value="#332B42" />
            <Setter Property="Foreground" Value="#F3EFF8" />
            <Setter Property="BorderBrush" Value="#554669" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Padding" Value="16,8" />
        </Style>
        <Style Selector="Button:pointerover">
            <Setter Property="Background" Value="#493A5E" />
            <Setter Property="BorderBrush" Value="#75608E" />
        </Style>
        <Style Selector="Button:disabled">
            <Setter Property="Opacity" Value="0.45" />
        </Style>
        <Style Selector="TextBox">
            <Setter Property="Background" Value="#1B1722" />
            <Setter Property="Foreground" Value="#F3EFF8" />
            <Setter Property="BorderBrush" Value="#554669" />
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,*,Auto">
        <Border Grid.Row="0" Background="#211B2A" BorderBrush="#3A3047"
                BorderThickness="0,0,0,1" Padding="22,18">
            <StackPanel Spacing="4">
                <TextBlock Text="ADD PERSONAL ADDON" Foreground="#F4F0F8"
                           FontSize="22" FontWeight="Bold" />
                <TextBlock Text="Paste a GitHub repository URL and Portalkeeper will discover the addon."
                           Foreground="#A99CB8" FontSize="13" />
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1">
            <StackPanel Margin="20" Spacing="14">
                <TextBlock Text="GITHUB REPOSITORY URL"
                           Foreground="#A99CB8" FontSize="11" FontWeight="SemiBold" />

                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                    <TextBox x:Name="GitUrlTextBox"
                             Watermark="https://github.com/owner/repository" />
                    <Button Grid.Column="1" Content="DISCOVER" Click="Discover_Click" />
                </Grid>

                <TextBlock x:Name="StatusTextBlock"
                           Text="Portalkeeper will inspect the repository without changing your AddOns folder."
                           Foreground="#81768D" FontSize="12"
                           TextWrapping="Wrap" />

                <Border x:Name="PreviewBorder"
                        IsVisible="False"
                        Padding="16"
                        Background="#211C29"
                        BorderBrush="#3E334C"
                        BorderThickness="1"
                        CornerRadius="6">
                    <StackPanel Spacing="8">
                        <TextBlock Text="FOUND ADDON" Foreground="#A99CB8"
                                   FontSize="11" FontWeight="SemiBold" />
                        <TextBlock x:Name="PreviewNameTextBlock"
                                   Foreground="#F2EDF6" FontSize="18"
                                   FontWeight="SemiBold" />
                        <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto"
                              ColumnSpacing="16" RowSpacing="5">
                            <TextBlock Text="Version" Foreground="#81768D" />
                            <TextBlock Grid.Column="1" x:Name="PreviewVersionTextBlock"
                                       Foreground="#C8BCD4" />
                            <TextBlock Grid.Row="1" Text="Addon folder" Foreground="#81768D" />
                            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="PreviewFolderTextBlock"
                                       Foreground="#C8BCD4" />
                            <TextBlock Grid.Row="2" Text="Branch" Foreground="#81768D" />
                            <TextBlock Grid.Row="2" Grid.Column="1" x:Name="PreviewBranchTextBlock"
                                       Foreground="#C8BCD4" />
                            <TextBlock Grid.Row="3" Text="Repository path" Foreground="#81768D" />
                            <TextBlock Grid.Row="3" Grid.Column="1" x:Name="PreviewPathTextBlock"
                                       Foreground="#C8BCD4" TextWrapping="Wrap" />
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Background="#211B2A" BorderBrush="#3A3047"
                BorderThickness="0,1,0,0" Padding="18,14">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="Personal addons never affect ENTER REALM readiness."
                           Foreground="#81768D" FontSize="11"
                           VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                    <Button x:Name="AddOnlyButton" Content="ADD ONLY"
                            IsEnabled="False" Click="AddOnly_Click" />
                    <Button x:Name="AddInstallButton" Content="ADD &amp; INSTALL"
                            IsEnabled="False" Click="AddInstall_Click" />
                    <Button Content="CANCEL" Click="Cancel_Click" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>

<Window
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="Portalkeeper.Views.AddAddonWindow"
    Width="700"
    Height="520"
    MinWidth="620"
    MinHeight="460"
    Title="Add Personal Addon"
    WindowStartupLocation="CenterOwner"
    Background="#091019">

    <Window.Styles>
        <Style Selector="Button">
            <Setter Property="Background" Value="#111A24" />
            <Setter Property="Foreground" Value="#F6D477" />
            <Setter Property="BorderBrush" Value="#9A6B1E" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Padding" Value="15,8" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Button:pointerover">
            <Setter Property="Background" Value="#1B2A38" />
            <Setter Property="BorderBrush" Value="#D2A43A" />
            <Setter Property="Foreground" Value="#FFE9A8" />
        </Style>
        <Style Selector="Button:disabled">
            <Setter Property="Opacity" Value="0.42" />
        </Style>
        <Style Selector="TextBox">
            <Setter Property="Background" Value="#0E1823" />
            <Setter Property="Foreground" Value="#F8F0DF" />
            <Setter Property="BorderBrush" Value="#6E5426" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Padding" Value="11,8" />
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,*,Auto">
        <Border Grid.Row="0"
                Background="#0A1119"
                BorderBrush="#A06E1B"
                BorderThickness="0,0,0,2">
            <Grid Height="96" ClipToBounds="True">
                <Image Source="/Assets/Calendar/calendar-banner.png"
                       Stretch="UniformToFill"
                       Opacity="0.84" />
                <Border Background="#79040A12" />
                <Grid Margin="20,10" ColumnDefinitions="58,*">
                    <Border Width="50" Height="50"
                            CornerRadius="25"
                            BorderBrush="#B77A20"
                            BorderThickness="2"
                            Background="#11131A"
                            VerticalAlignment="Center">
                        <Image Source="/Assets/portalkeeper-icon.png"
                               Margin="3"
                               Stretch="Uniform" />
                    </Border>
                    <StackPanel Grid.Column="1"
                                Margin="14,0,0,0"
                                VerticalAlignment="Center"
                                Spacing="2">
                        <TextBlock Text="ADD PERSONAL ADDON"
                                   Foreground="#FFD96B"
                                   FontSize="22"
                                   FontWeight="Bold" />
                        <TextBlock Text="Discover an addon from a GitHub repository"
                                   Foreground="#E8DDC8"
                                   FontSize="12" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1">
            <StackPanel Margin="20,18" Spacing="14">
                <Border Background="#0E1823"
                        BorderBrush="#6E5426"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="16">
                    <StackPanel Spacing="10">
                        <TextBlock Text="GITHUB REPOSITORY URL"
                                   Foreground="#D5AA50"
                                   FontSize="11"
                                   FontWeight="Bold" />
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                            <TextBox x:Name="GitUrlTextBox"
                                     PlaceholderText="https://github.com/owner/repository" />
                            <Button Grid.Column="1"
                                    Content="DISCOVER"
                                    Click="Discover_Click"
                                    Padding="18,8" />
                        </Grid>
                        <TextBlock x:Name="StatusTextBlock"
                                   Text="Portalkeeper will inspect the repository without changing your AddOns folder."
                                   Foreground="#8F8577"
                                   FontSize="12"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border x:Name="PreviewBorder"
                        IsVisible="False"
                        Padding="16"
                        Background="#0E1823"
                        BorderBrush="#6E5426"
                        BorderThickness="1"
                        CornerRadius="4">
                    <StackPanel Spacing="9">
                        <TextBlock Text="FOUND ADDON"
                                   Foreground="#D5AA50"
                                   FontSize="11"
                                   FontWeight="Bold" />
                        <TextBlock x:Name="PreviewNameTextBlock"
                                   Foreground="#F8F0DF"
                                   FontSize="19"
                                   FontWeight="SemiBold" />
                        <Border Height="1" Background="#2D281B" Margin="0,2" />
                        <Grid ColumnDefinitions="120,*"
                              RowDefinitions="Auto,Auto,Auto,Auto"
                              ColumnSpacing="16"
                              RowSpacing="6">
                            <TextBlock Text="Version" Foreground="#807666" />
                            <TextBlock Grid.Column="1" x:Name="PreviewVersionTextBlock" Foreground="#D8CCBA" />
                            <TextBlock Grid.Row="1" Text="Addon folder" Foreground="#807666" />
                            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="PreviewFolderTextBlock" Foreground="#D8CCBA" />
                            <TextBlock Grid.Row="2" Text="Branch" Foreground="#807666" />
                            <TextBlock Grid.Row="2" Grid.Column="1" x:Name="PreviewBranchTextBlock" Foreground="#D8CCBA" />
                            <TextBlock Grid.Row="3" Text="Repository path" Foreground="#807666" />
                            <TextBlock Grid.Row="3" Grid.Column="1" x:Name="PreviewPathTextBlock"
                                       Foreground="#D8CCBA" TextWrapping="Wrap" />
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2"
                Background="#081019"
                BorderBrush="#5B431B"
                BorderThickness="0,1,0,0"
                Padding="18,12">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="Personal addons never affect ENTER REALM readiness."
                           Foreground="#756B5C"
                           FontSize="11"
                           VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="9">
                    <Button x:Name="AddOnlyButton"
                            Content="ADD ONLY"
                            IsEnabled="False"
                            Click="AddOnly_Click" />
                    <Button x:Name="AddInstallButton"
                            Content="ADD &amp; INSTALL"
                            IsEnabled="False"
                            Click="AddInstall_Click" />
                    <Button Content="CANCEL" Click="Cancel_Click" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>

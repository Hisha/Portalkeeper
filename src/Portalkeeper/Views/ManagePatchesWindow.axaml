<Window xmlns="https://github.com/avaloniaui"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:Portalkeeper.ViewModels"
 xmlns:models="using:Portalkeeper.Models" x:Class="Portalkeeper.Views.ManagePatchesWindow"
 x:DataType="vm:MainViewModel" Title="Portalkeeper — Realm Patches" Width="820" Height="520"
 MinWidth="640" MinHeight="360" Background="#091019" WindowStartupLocation="CenterOwner">

 <!-- This window has a fixed dark surface; keep actions legible in either system theme. -->
    <Window.Styles>
        <Style Selector="Button">
            <Setter Property="Background" Value="#111A24" />
            <Setter Property="Foreground" Value="#F6D477" />
            <Setter Property="BorderBrush" Value="#9A6B1E" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Padding" Value="15,8" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Button:pointerover">
            <Setter Property="Background" Value="#1B2A38" />
            <Setter Property="BorderBrush" Value="#D2A43A" />
            <Setter Property="Foreground" Value="#FFE9A8" />
        </Style>
        <Style Selector="Button:pressed">
            <Setter Property="Background" Value="#0C131B" />
        </Style>
        <Style Selector="Button:disabled">
            <Setter Property="Opacity" Value="0.42" />
        </Style>
    </Window.Styles>

 <Grid Margin="24" RowDefinitions="Auto,*,Auto" RowSpacing="16">
  <StackPanel Spacing="6">
   <TextBlock Text="REALM PATCHES" FontSize="24" Foreground="#D5AA50" />
   <TextBlock Text="Required patches must be valid before launch. Existing files are inspected; changes retain backups."
    TextWrapping="Wrap" Foreground="#AFA28D" />
  </StackPanel>
  <ScrollViewer Grid.Row="1">
   <ItemsControl ItemsSource="{Binding Patches}">
    <ItemsControl.ItemTemplate><DataTemplate x:DataType="models:PatchInfo">
     <Border Margin="0,0,0,12" Padding="16" Background="#0E1823" BorderBrush="#6E5426" BorderThickness="1" CornerRadius="4">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
       <StackPanel Spacing="5">
        <TextBlock Text="{Binding Definition.Name}" FontSize="18" Foreground="#F8F0DF" />
        <TextBlock Text="{Binding Definition.Requirement}" Foreground="#D5AA50" />
        <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Foreground="#AFA28D" />
        <TextBlock Text="{Binding Destination}" TextWrapping="Wrap" Foreground="#AFA28D" FontSize="11" />
       </StackPanel>
       <StackPanel Grid.Column="1" Spacing="8">
        <Button Content="INSTALL / REPAIR" Click="Install_Click" />
        <Button Content="REMOVE" Click="Remove_Click" IsEnabled="{Binding IsInstalled}" />
       </StackPanel>
      </Grid>
     </Border>
    </DataTemplate></ItemsControl.ItemTemplate>
   </ItemsControl>
  </ScrollViewer>
  <Button Grid.Row="2" Content="CLOSE" Click="Close_Click" HorizontalAlignment="Right" />
 </Grid>
</Window>

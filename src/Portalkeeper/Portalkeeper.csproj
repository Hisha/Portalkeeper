<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <!-- The release's version: the only one to change. The launcher reads InformationalVersion as its
         own (update checks, MinimumVersion), so the others follow it. -->
    <Version>0.5.55</Version>
    <AssemblyVersion>$(Version).0</AssemblyVersion>
    <FileVersion>$(Version).0</FileVersion>
    <InformationalVersion>$(Version)</InformationalVersion>
    <Product>Portalkeeper</Product>
    <Description>Cross-platform realm launcher and addon manager for World of Warcraft 3.3.5a.</Description>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\..\assets\branding\portalkeeper-icon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Portalkeeper.RuntimeTests" />
    <Folder Include="Models\" />
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.2" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.2" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.2" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.2" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <!-- Client and patch downloads shared between players (BitTorrent with the realm's web seed). -->
    <PackageReference Include="MonoTorrent" Version="3.0.2" />
    <!-- Encrypts the saved launcher login for the current Windows user (DPAPI). -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.0" />
  </ItemGroup>
  <ItemGroup>
    <!-- Cinzel (SIL Open Font License 1.1) is embedded under Assets/Fonts; its license ships in the install as Assets/Fonts/Cinzel-OFL.txt. -->
    <None Include="Assets\Fonts\Cinzel-OFL.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <!-- The realm this build is made for; copied into the realm store on first run. -->
    <EmbeddedResource Include="Branding\azeroth.realm.conf" LogicalName="Portalkeeper.Branding.azeroth.realm.conf" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\config\example.realm.conf"
          Link="config\example.realm.conf"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Keep RID-less builds portable; flatten the native asset for Windows x64 publish. -->
  <ItemGroup Condition="'$(RuntimeIdentifier)' == '' Or '$(RuntimeIdentifier)' == 'win-x64'">
    <None Update="runtimes/win-x64/native/StormLib.dll;runtimes/win-x64/native/StormLib.LICENSE.txt"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest">
      <TargetPath Condition="'$(RuntimeIdentifier)' == 'win-x64'">%(Filename)%(Extension)</TargetPath>
    </None>
  </ItemGroup>

</Project>

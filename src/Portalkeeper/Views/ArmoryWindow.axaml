<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Portalkeeper.ViewModels"
        xmlns:models="using:Portalkeeper.Models"
        x:Class="Portalkeeper.Views.ArmoryWindow"
        x:DataType="vm:ArmoryViewModel"
        Title="Realm Armory"
        Width="1280" Height="830"
        MinWidth="1040" MinHeight="680"
        WindowStartupLocation="CenterOwner"
        Background="#071019">

    <Window.Styles>
        <Style Selector="TextBox">
            <Setter Property="Background" Value="#0B151E"/>
            <Setter Property="Foreground" Value="#E9DFC9"/>
            <Setter Property="BorderBrush" Value="#765522"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,9"/>
        </Style>
        <Style Selector="ComboBox">
            <Setter Property="Background" Value="#0B151E"/>
            <Setter Property="Foreground" Value="#E9DFC9"/>
            <Setter Property="BorderBrush" Value="#765522"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,7"/>
        </Style>
        <Style Selector="ListBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="158,*,Auto">
        <!-- Cinematic header -->
        <Grid Grid.Row="0">
            <Image Source="/Assets/Calendar/calendar-banner.png"
                   Stretch="UniformToFill"
                   Opacity="0.78"/>
            <Border Background="#78030A10"/>
            <Border BorderBrush="#9A6D25" BorderThickness="0,0,0,2"/>
            <Grid Margin="34,22" ColumnDefinitions="*,Auto">
                <StackPanel VerticalAlignment="Center" Spacing="3">
                    <TextBlock Text="REALM ARMORY"
                               FontSize="34"
                               FontWeight="Bold"
                               Foreground="#F3D58C"/>
                    <TextBlock Text="Heroes, adventurers, and denizens of the realm"
                               FontSize="15"
                               Foreground="#D8C9A7"/>
                    <Border Width="270" Height="1" Background="#A67528" Margin="0,8,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Right"
                            Spacing="4">
                    <TextBlock Text="PORTALKEEPER"
                               HorizontalAlignment="Right"
                               FontWeight="Bold"
                               FontSize="14"
                               Foreground="#C6A45E"/>
                    <TextBlock Text="REALM CHARACTER ARCHIVE"
                               HorizontalAlignment="Right"
                               FontSize="10"
                               Foreground="#8F826F"/>
                </StackPanel>
            </Grid>
        </Grid>

        <Grid Grid.Row="1"
              Margin="22"
              ColumnDefinitions="350,*"
              ColumnSpacing="18">

            <!-- Character roster -->
            <Border Background="#0D1822"
                    BorderBrush="#765522"
                    BorderThickness="1"
                    CornerRadius="6">
                <Grid RowDefinitions="Auto,Auto,Auto,*">
                    <Border Grid.Row="0"
                            Background="#111F2B"
                            BorderBrush="#4D3B20"
                            BorderThickness="0,0,0,1"
                            Padding="16,13">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel>
                                <TextBlock Text="CHARACTER ROSTER"
                                           FontWeight="Bold"
                                           FontSize="14"
                                           Foreground="#D5AA50"/>
                                <TextBlock Text="{Binding RosterSummary}"
                                           FontSize="11"
                                           Foreground="#8F8575"
                                           Margin="0,3,0,0"/>
                            </StackPanel>
                            <Border Grid.Column="1"
                                    Background="#151125"
                                    BorderBrush="#654B81"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="9,4"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{Binding TotalPlayerbots, StringFormat='{}{0:N0} BOTS'}"
                                           FontSize="10"
                                           FontWeight="Bold"
                                           Foreground="#C8A5E8"/>
                            </Border>
                        </Grid>
                    </Border>

                    <TextBox Grid.Row="1"
                             Margin="14,14,14,8"
                             PlaceholderText="Search characters..."
                             Text="{Binding SearchText}"/>

                    <ComboBox Grid.Row="2"
                              Margin="14,0,14,10"
                              ItemsSource="{Binding Filters}"
                              SelectedIndex="{Binding FilterIndex}"/>

                    <ListBox Grid.Row="3"
                             Margin="9,0,9,10"
                             ItemsSource="{Binding Characters}"
                             SelectedItem="{Binding SelectedSummary}">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="models:ArmoryCharacterSummary">
                                <Border Padding="11,9"
                                        Margin="2,2"
                                        Background="#0A141D"
                                        BorderBrush="#332A1D"
                                        BorderThickness="1"
                                        CornerRadius="4">
                                    <Grid ColumnDefinitions="Auto,*,Auto"
                                          ColumnSpacing="10">
                                        <Border Width="42"
                                                Height="42"
                                                Background="#172532"
                                                BorderBrush="#5D4826"
                                                BorderThickness="1"
                                                CornerRadius="21"
                                                VerticalAlignment="Center">
                                            <StackPanel VerticalAlignment="Center"
                                                        HorizontalAlignment="Center"
                                                        Spacing="-2">
                                                <TextBlock Text="{Binding Level}"
                                                           HorizontalAlignment="Center"
                                                           FontSize="15"
                                                           FontWeight="Bold"
                                                           Foreground="#F0D28A"/>
                                                <TextBlock Text="LV"
                                                           HorizontalAlignment="Center"
                                                           FontSize="8"
                                                           Foreground="#7F776C"/>
                                            </StackPanel>
                                        </Border>

                                        <StackPanel Grid.Column="1"
                                                    VerticalAlignment="Center"
                                                    Spacing="2">
                                            <TextBlock Text="{Binding Name}"
                                                       FontSize="16"
                                                       FontWeight="Bold"
                                                       Foreground="#E9DFC9"/>
                                            <TextBlock Text="{Binding RaceName}"
                                                       FontSize="11"
                                                       Foreground="#9B9181"/>
                                            <TextBlock Text="{Binding ClassName}"
                                                       FontSize="11"
                                                       Foreground="#C7A966"/>
                                        </StackPanel>

                                        <Border Grid.Column="2"
                                                Background="#191426"
                                                BorderBrush="#644B80"
                                                BorderThickness="1"
                                                CornerRadius="9"
                                                Padding="7,3"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{Binding TypeLabel}"
                                                       FontSize="9"
                                                       FontWeight="Bold"
                                                       Foreground="#C7A0E9"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- Profile -->
            <Border Grid.Column="1"
                    Background="#0D1822"
                    BorderBrush="#765522"
                    BorderThickness="1"
                    CornerRadius="6">
                <Grid>
                    <StackPanel IsVisible="{Binding HasNoSelectedCharacter}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Spacing="10">
                        <TextBlock Text="◆"
                                   HorizontalAlignment="Center"
                                   FontSize="34"
                                   Foreground="#6D542B"/>
                        <TextBlock Text="SELECT A CHARACTER"
                                   HorizontalAlignment="Center"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="#D9BD7B"/>
                        <TextBlock Text="Choose a hero from the roster to inspect their equipment."
                                   HorizontalAlignment="Center"
                                   FontSize="13"
                                   Foreground="#887F72"/>
                    </StackPanel>

                    <Grid IsVisible="{Binding HasSelectedCharacter}"
                          RowDefinitions="Auto,*">

                        <!-- Character identity / summary -->
                        <Border Grid.Row="0"
                                Background="#111F2B"
                                BorderBrush="#4D3B20"
                                BorderThickness="0,0,0,1"
                                Padding="20,16">
                            <Grid RowDefinitions="Auto,Auto"
                                  ColumnDefinitions="*,Auto"
                                  ColumnSpacing="18">

                                <StackPanel Grid.Row="0"
                                            Spacing="2">
                                    <TextBlock Text="{Binding SelectedCharacter.Name}"
                                               FontSize="31"
                                               FontWeight="Bold"
                                               Foreground="#F3D58C"/>
                                    <TextBlock Text="{Binding SelectedCharacter.Subtitle}"
                                               FontSize="15"
                                               Foreground="#D0C09E"/>
                                    <TextBlock Text="{Binding SelectedCharacter.FactionName}"
                                               FontSize="11"
                                               Foreground="#8E8578"/>
                                </StackPanel>

                                <Border Grid.Row="0"
                                        Grid.Column="1"
                                        Background="#21162F"
                                        BorderBrush="#805CA2"
                                        BorderThickness="1"
                                        CornerRadius="11"
                                        Padding="12,5"
                                        VerticalAlignment="Center"
                                        IsVisible="{Binding SelectedCharacter.Playerbot}">
                                    <TextBlock Text="PLAYERBOT"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               Foreground="#D9B5F5"/>
                                </Border>

                                <Grid Grid.Row="1"
                                      Grid.ColumnSpan="2"
                                      Margin="0,14,0,0"
                                      ColumnDefinitions="*,*,*"
                                      ColumnSpacing="9">
                                    <Border Background="#0A151E"
                                            BorderBrush="#3B3020"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Padding="12,9">
                                        <StackPanel>
                                            <TextBlock Text="EQUIPPED"
                                                       FontSize="9"
                                                       FontWeight="Bold"
                                                       Foreground="#8E826F"/>
                                            <TextBlock Text="{Binding SelectedCharacter.EquippedCount}"
                                                       FontSize="21"
                                                       FontWeight="Bold"
                                                       Foreground="#E8D7B4"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="1"
                                            Background="#0A151E"
                                            BorderBrush="#3B3020"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Padding="12,9">
                                        <StackPanel>
                                            <TextBlock Text="AVG ITEM LEVEL"
                                                       FontSize="9"
                                                       FontWeight="Bold"
                                                       Foreground="#8E826F"/>
                                            <TextBlock Text="{Binding SelectedCharacter.AverageItemLevel}"
                                                       FontSize="21"
                                                       FontWeight="Bold"
                                                       Foreground="#E8D7B4"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="2"
                                            Background="#0A151E"
                                            BorderBrush="#3B3020"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Padding="12,9">
                                        <StackPanel>
                                            <TextBlock Text="HIGHEST ILVL"
                                                       FontSize="9"
                                                       FontWeight="Bold"
                                                       Foreground="#8E826F"/>
                                            <TextBlock Text="{Binding SelectedCharacter.HighestItemLevel}"
                                                       FontSize="21"
                                                       FontWeight="Bold"
                                                       Foreground="#E8D7B4"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- Equipment cards -->
                        <ScrollViewer Grid.Row="1"
                                      Margin="16"
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Spacing="10">
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel>
                                        <TextBlock Text="EQUIPMENT"
                                                   FontSize="14"
                                                   FontWeight="Bold"
                                                   Foreground="#D0A34A"/>
                                        <TextBlock Text="Current equipped items published by the realm"
                                                   FontSize="11"
                                                   Foreground="#837A6E"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding SelectedCharacter.GearSummary}"
                                               VerticalAlignment="Bottom"
                                               FontSize="11"
                                               Foreground="#8E8578"/>
                                </Grid>

                                <ItemsControl ItemsSource="{Binding SelectedCharacter.Equipment}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="models:ArmoryEquipmentItem">
                                            <Border Width="406"
                                                    MinHeight="78"
                                                    Margin="0,0,9,9"
                                                    Background="#09131C"
                                                    BorderBrush="#3D3120"
                                                    BorderThickness="1"
                                                    CornerRadius="5">
                                                <Grid ColumnDefinitions="58,*">
                                                    <Border Background="#14222E"
                                                            BorderBrush="#5C4725"
                                                            BorderThickness="0,0,1,0"
                                                            CornerRadius="5,0,0,5">
                                                        <StackPanel HorizontalAlignment="Center"
                                                                    VerticalAlignment="Center"
                                                                    Spacing="2">
                                                            <TextBlock Text="{Binding SlotAbbreviation}"
                                                                       HorizontalAlignment="Center"
                                                                       FontSize="16"
                                                                       FontWeight="Bold"
                                                                       Foreground="#D4AD5B"/>
                                                            <TextBlock Text="{Binding SlotName}"
                                                                       HorizontalAlignment="Center"
                                                                       FontSize="8"
                                                                       Foreground="#857B6C"/>
                                                        </StackPanel>
                                                    </Border>

                                                    <Grid Grid.Column="1"
                                                          Margin="12,8"
                                                          RowDefinitions="Auto,Auto"
                                                          ColumnDefinitions="*,Auto">
                                                        <TextBlock Text="{Binding Name}"
                                                                   FontSize="14"
                                                                   FontWeight="Bold"
                                                                   Foreground="#EFE1C6"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Grid.Row="1"
                                                                   Text="{Binding QualityDetail}"
                                                                   FontSize="10"
                                                                   Foreground="#9C9283"
                                                                   Margin="0,3,0,0"/>
                                                        <Border Grid.Column="1"
                                                                Grid.RowSpan="2"
                                                                Background="#101D27"
                                                                BorderBrush="#493A22"
                                                                BorderThickness="1"
                                                                CornerRadius="8"
                                                                Padding="7,3"
                                                                VerticalAlignment="Center"
                                                                Margin="8,0,0,0">
                                                            <TextBlock Text="{Binding Entry}"
                                                                       FontSize="9"
                                                                       Foreground="#827869"/>
                                                        </Border>
                                                    </Grid>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2"
                Background="#08131C"
                BorderBrush="#40331E"
                BorderThickness="0,1,0,0"
                Padding="22,10">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="{Binding Status}"
                           Foreground="#8F8577"
                           FontSize="11"/>
                <TextBlock Grid.Column="1"
                           Text="Loading character profile..."
                           IsVisible="{Binding LoadingProfile}"
                           Foreground="#C1A464"
                           FontSize="11"/>
            </Grid>
        </Border>
    </Grid>
</Window>

<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Portalkeeper.ViewModels"
        xmlns:models="using:Portalkeeper.Models"
        x:Class="Portalkeeper.Views.NewsWindow"
        x:DataType="vm:NewsViewModel"
        Title="Realm News"
        Width="1080"
        Height="720"
        MinWidth="900"
        MinHeight="620"
        WindowStartupLocation="CenterOwner"
        Background="#07111A">

    <Window.Styles>
        <Style Selector="Button">
            <Setter Property="Background" Value="#101D29" />
            <Setter Property="Foreground" Value="#F1C65B" />
            <Setter Property="BorderBrush" Value="#A56A16" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
        <Style Selector="ListBoxItem:selected">
            <Setter Property="Background" Value="Transparent" />
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="112,*,34">
        <!-- Cinematic header -->
        <Border Grid.Row="0"
                BorderBrush="#B77A20"
                BorderThickness="0,1,0,2">
            <Grid ClipToBounds="True">
                <Image Source="/Assets/Calendar/calendar-banner.png"
                       Stretch="UniformToFill"
                       Opacity="0.86" />
                <Border Background="#65030A11" />
                <Grid Margin="24,12" ColumnDefinitions="72,*,Auto" ColumnSpacing="14">
                    <Border Width="64" Height="64"
                            CornerRadius="32"
                            BorderBrush="#C99527"
                            BorderThickness="1"
                            Background="#11131B"
                            VerticalAlignment="Center">
                        <Image Source="/Assets/portalkeeper-icon.png"
                               Stretch="Uniform"
                               Margin="4" />
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                        <TextBlock Text="REALM NEWS"
                                   FontSize="30"
                                   FontWeight="Bold"
                                   Foreground="#F1C65B" />
                        <TextBlock Text="Announcements, improvements, maintenance, and realm updates"
                                   FontSize="13"
                                   Foreground="#EEE4D1" />
                    </StackPanel>

                    <StackPanel Grid.Column="2"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Right">
                        <TextBlock Text="PORTALKEEPER"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   Foreground="#D9B9EF"
                                   HorizontalAlignment="Right" />
                        <TextBlock Text="STAY INFORMED"
                                   FontSize="9"
                                   Foreground="#8E78A8"
                                   HorizontalAlignment="Right" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- Content -->
        <Grid Grid.Row="1"
              Margin="18,16"
              ColumnDefinitions="360,12,*">

            <!-- Article index -->
            <Border Grid.Column="0"
                    Background="#0B1722"
                    BorderBrush="#8A5B19"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="12">
                <Grid RowDefinitions="Auto,8,*">
                    <StackPanel>
                        <TextBlock Text="LATEST FROM THE REALM"
                                   FontSize="12"
                                   FontWeight="Bold"
                                   Foreground="#C99B3D" />
                        <TextBlock Text="{Binding ArticleCountText}"
                                   FontSize="11"
                                   Foreground="#8E8678" />
                    </StackPanel>

                    <ListBox Grid.Row="2"
                             ItemsSource="{Binding Articles}"
                             SelectedItem="{Binding SelectedArticle}">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="models:RealmNewsArticle">
                                <Border Background="#101E2B"
                                        BorderBrush="#3C3224"
                                        BorderThickness="1"
                                        CornerRadius="3"
                                        Padding="11">
                                    <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="4">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                            <TextBlock Text="{Binding CategoryDisplay}"
                                                       FontSize="9"
                                                       FontWeight="Bold"
                                                       Foreground="#D09B32" />
                                            <Border Grid.Column="1"
                                                    IsVisible="{Binding Pinned}"
                                                    Background="#3A2450"
                                                    BorderBrush="#81609B"
                                                    BorderThickness="1"
                                                    CornerRadius="8"
                                                    Padding="7,2">
                                                <TextBlock Text="FEATURED"
                                                           FontSize="8"
                                                           FontWeight="Bold"
                                                           Foreground="#E5C7FA" />
                                            </Border>
                                        </Grid>
                                        <TextBlock Grid.Row="1"
                                                   Text="{Binding Title}"
                                                   FontSize="15"
                                                   FontWeight="SemiBold"
                                                   Foreground="#F8F0DF"
                                                   TextWrapping="Wrap" />
                                        <StackPanel Grid.Row="2" Spacing="3">
                                            <TextBlock Text="{Binding Summary}"
                                                       MaxLines="2"
                                                       TextTrimming="CharacterEllipsis"
                                                       FontSize="11"
                                                       Foreground="#B4AA9B"
                                                       TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding PublishedDisplay}"
                                                       FontSize="10"
                                                       Foreground="#777C80" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- Selected article -->
            <Border Grid.Column="2"
                    Background="#0A151F"
                    BorderBrush="#8A5B19"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="4">
                <Border BorderBrush="#3B2D18"
                        BorderThickness="1"
                        CornerRadius="3"
                        Padding="22">
                    <Grid>
                        <ScrollViewer IsVisible="{Binding HasSelection}"
                                      VerticalScrollBarVisibility="Auto">
                            <StackPanel Spacing="12"
                                        DataContext="{Binding SelectedArticle}">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                    <StackPanel>
                                        <TextBlock Text="{Binding CategoryDisplay}"
                                                   FontSize="11"
                                                   FontWeight="Bold"
                                                   Foreground="#D09B32" />
                                        <TextBlock Text="{Binding Title}"
                                                   FontSize="28"
                                                   FontWeight="Bold"
                                                   Foreground="#F8F0DF"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                    <Border Grid.Column="1"
                                            IsVisible="{Binding Pinned}"
                                            Background="#3A2450"
                                            BorderBrush="#8B65A5"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                            Padding="10,4"
                                            VerticalAlignment="Top">
                                        <TextBlock Text="FEATURED"
                                                   FontSize="9"
                                                   FontWeight="Bold"
                                                   Foreground="#E8C9FB" />
                                    </Border>
                                </Grid>

                                <TextBlock Text="{Binding Byline}"
                                           FontSize="11"
                                           Foreground="#8F91A0" />

                                <Border Height="1" Background="#49351D" />

                                <TextBlock Text="{Binding Summary}"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           Foreground="#D7C8AF"
                                           TextWrapping="Wrap" />

                                <TextBlock Text="{Binding Body}"
                                           FontSize="14"
                                           LineHeight="21"
                                           Foreground="#C7C1B7"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </ScrollViewer>

                        <StackPanel IsVisible="{Binding !HasArticles}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Spacing="8">
                            <TextBlock Text="NO REALM NEWS YET"
                                       FontSize="20"
                                       FontWeight="Bold"
                                       Foreground="#C99B3D"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="Published announcements will appear here."
                                       FontSize="12"
                                       Foreground="#8E8678"
                                       HorizontalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Border>
        </Grid>

        <!-- Footer -->
        <Border Grid.Row="2"
                BorderBrush="#49351D"
                BorderThickness="0,1,0,0"
                Background="#07111A">
            <Grid Margin="18,0" ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                <TextBlock Text="{Binding LoadStatus}"
                           FontSize="10"
                           Foreground="#9B9EA4" />
                <TextBlock Grid.Column="1"
                           Text="{Binding FeedGeneratedDisplay}"
                           FontSize="10"
                           Foreground="#696D75" />
            </Grid>
        </Border>
    </Grid>
</Window>
